# Sólo para ejecución local con Node.js. Docker incluye su configuración en la imagen.
# Rutas locales. No coloque secretos aquí.
WHATSAPP_READER_DATA_DIR=./data
WHATSAPP_READER_DB_PATH=./data/whatsapp.sqlite
WHATSAPP_READER_AUTH_DIR=./auth

# IPC local: socket Unix en Linux; en Windows esta ruta se transforma en una named pipe.
# También puede omitir SEND_SOCKET para usar el canal derivado de DATA_DIR.
# Windows admite un nombre explícito, por ejemplo: \\.\pipe\whatsapp-reader-personal
# Ambos procesos deben usar la misma configuración y usuario (no se abre un puerto TCP).
WHATSAPP_READER_SEND_SOCKET=./data/send.sock
WHATSAPP_READER_SEND_TIMEOUT_MS=15000

# Zona IANA usada para interpretar fechas sin hora (YYYY-MM-DD).
WHATSAPP_READER_TIME_ZONE=America/Argentina/Buenos_Aires

# Límites defensivos (los máximos absolutos también están fijados en código).
WHATSAPP_READER_DEFAULT_LIMIT=20
WHATSAPP_READER_LOG_LEVEL=info
WHATSAPP_READER_MAX_RECONNECT_ATTEMPTS=8
WHATSAPP_READER_RECONNECT_BASE_MS=1000
