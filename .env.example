# Rutas locales. No coloque secretos aquí.
WHATSAPP_READER_DATA_DIR=./data
WHATSAPP_READER_DB_PATH=./data/whatsapp.sqlite
WHATSAPP_READER_AUTH_DIR=./auth

# Zona IANA usada para interpretar fechas sin hora (YYYY-MM-DD).
WHATSAPP_READER_TIME_ZONE=America/Argentina/Buenos_Aires

# Límites defensivos (los máximos absolutos también están fijados en código).
WHATSAPP_READER_DEFAULT_LIMIT=20
WHATSAPP_READER_LOG_LEVEL=info
WHATSAPP_READER_MAX_RECONNECT_ATTEMPTS=8
WHATSAPP_READER_RECONNECT_BASE_MS=1000
